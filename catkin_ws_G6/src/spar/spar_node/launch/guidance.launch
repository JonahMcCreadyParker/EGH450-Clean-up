<?xml version="1.0"?>

<launch>

    <!--
        Central configuration file for the complete
        autopilot / guidance mission.
    -->
    <arg
        name="config_file"
        default="$(find spar_node)/config/guidance.yaml"
    />

    <!--
        Main guidance node.
        All mission parameters are loaded into this
        node's private ROS namespace.
    -->
    <node
        name="guidance"
        pkg="spar_node"
        type="guidance"
        respawn="false"
        output="screen"
    >

        <rosparam
            command="load"
            file="$(arg config_file)"
        />

    </node>

</launch>