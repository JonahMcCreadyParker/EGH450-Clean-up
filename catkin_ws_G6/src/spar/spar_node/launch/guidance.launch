<?xml version="1.0"?>

<launch>

    <!-- ========================================================= -->
    <!-- Guidance Configuration                                    -->
    <!-- ========================================================= -->

    <arg
        name="config_file"
        default="$(find spar_node)/config/guidance.yaml"
    />


    <!-- ========================================================= -->
    <!-- Breadcrumb Obstacle-Aware Path Planner                    -->
    <!-- ========================================================= -->

    <include
        file="$(find breadcrumb)/launch/breadcrumb.launch"
    />


    <!-- ========================================================= -->
    <!-- Main Guidance / Autonomous Mission Node                   -->
    <!-- ========================================================= -->

    <node
        name="guidance"
        pkg="spar_node"
        type="guidance"
        respawn="false"
        output="screen"
    >

        <rosparam
            command="load"
            file="$(arg config_file)"
        />

    </node>

</launch>