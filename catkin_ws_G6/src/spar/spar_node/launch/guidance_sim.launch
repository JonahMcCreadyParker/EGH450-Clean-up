<?xml version="1.0"?>

<launch>

    <!-- ===================================================== -->
    <!-- UAS Emulator                                         -->
    <!-- ===================================================== -->

    <node
        pkg="uavasr_emulator"
        type="uavasr_emulator_node"
        name="uavasr"
        clear_params="true"
        output="screen"
    >

        <param
            name="frame_id"
            value="map"
            type="str"
        />

        <param
            name="model_id"
            value="emulated_uav"
            type="str"
        />

        <!--
            Emulator begins in the conditions that SPAR
            normally waits for on the real aircraft.
        -->
        <param
            name="start_armed"
            value="true"
            type="bool"
        />

        <param
            name="start_mode_offboard"
            value="true"
            type="bool"
        />

        <param
            name="update_rate_pose"
            value="50.0"
            type="double"
        />

        <param
            name="update_rate_battery"
            value="1.0"
            type="double"
        />

        <param
            name="update_rate_state"
            value="1.0"
            type="double"
        />

    </node>


    <!-- ===================================================== -->
    <!-- SPAR                                                  -->
    <!-- ===================================================== -->

    <remap
        from="spar/mav_state"
        to="uavasr/state"
    />

    <remap
        from="spar/pose"
        to="uavasr/pose"
    />

    <remap
        from="spar/setpoint"
        to="uavasr/setpoint_raw/local"
    />

    <include
        file="$(find spar_node)/launch/spar.launch"
    />


    <!-- ===================================================== -->
    <!-- Occupancy Grid                                       -->
    <!-- ===================================================== -->

    <node
        pkg="qutas_lab_450"
        type="area_map_node"
        name="area_map"
        clear_params="true"
        output="screen"
    >

        <remap
            from="~/grid"
            to="/grid"
        />

        <param
            name="frame_id"
            value="map"
            type="str"
        />

        <rosparam
            command="load"
            file="$(find qutas_lab_450)/launch/map_layout.yaml"
        />

    </node>


    <!-- ===================================================== -->
    <!-- Breadcrumb Path Planner                              -->
    <!-- ===================================================== -->

    <node
        pkg="breadcrumb"
        type="breadcrumb_node"
        name="breadcrumb"
        clear_params="true"
        output="screen"
    >

        <!-- A* search configuration -->

        <param
            name="search_heuristic"
            value="1"
            type="int"
        />

        <param
            name="allow_diagonals"
            value="true"
            type="bool"
        />

        <param
            name="any_angle"
            value="true"
            type="bool"
        />

        <param
            name="obstacle_threshold"
            value="1"
            type="int"
        />

        <param
            name="calc_sparse_path"
            value="true"
            type="bool"
        />

        <!-- Keep planning inside the permitted mission area -->

        <param
            name="enforce_bounds"
            value="true"
            type="bool"
        />

        <param
            name="x_min"
            value="-4.0"
            type="double"
        />

        <param
            name="x_max"
            value="4.0"
            type="double"
        />

        <param
            name="y_min"
            value="-3.2"
            type="double"
        />

        <param
            name="y_max"
            value="2.1"
            type="double"
        />

        <param
            name="z_min"
            value="0.5"
            type="double"
        />

        <param
            name="z_max"
            value="4.0"
            type="double"
        />

        <!-- Breadcrumb receives the occupancy grid here -->

        <remap
            from="~grid"
            to="/grid"
        />

    </node>


    

    <!-- ===================================================== -->
    <!-- Guidance                                              -->
    <!-- ===================================================== -->

    <node
        name="guidance"
        pkg="spar_node"
        type="guidance"
        respawn="false"
        output="screen"
    >

        <rosparam
            command="load"
            file="$(find spar_node)/config/guidance.yaml"
        />

        <!--
            Preserve the real-flight topic names inside
            guidance.yaml and remap only for simulation.
        -->

        <remap
            from="/mavros/local_position/pose"
            to="/uavasr/pose"
        />

        <remap
            from="/mavros/battery"
            to="/uavasr/battery"
        />

    </node>

</launch>