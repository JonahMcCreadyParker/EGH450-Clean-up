<!-- pdd_bench.launch -->
<launch>
    <!-- The flight configuration: motor_controller + payload_driver -->
    <include file="$(find egh450_payload_deploy)/launch/pdd_launch.launch"/>

    <!-- Bench-only: stands in for nav, publishes /payload/nav_clearance -->
    <node name="nav_simulator" pkg="egh450_payload_deploy" type="nav_simulator.py"
          output="screen"/>

    <!-- Bench-only: keyboard servo control on /motor_manual_override -->
    <node name="manual_override" pkg="egh450_payload_deploy" type="manual_override.py"
          output="screen" launch-prefix="xterm -e"/>
</launch>