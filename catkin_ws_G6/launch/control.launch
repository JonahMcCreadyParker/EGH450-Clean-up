<?xml version='1.0'?>
<launch>
	<!-- Launch Parameters -->
	<node name="guidance" pkg="spar_node" type="demo_wp_roi" respawn="false" output="screen">
		<!-- Linear and yaw motion velocities -->
		<param name="vel_linear" type="double" value="0.3" /> 	<!-- m/s -->
		<param name="vel_yaw" type="double" value="0.2" /> 		<!-- m/s -->
		<param name="flight_height" type="double" value="1.7" /><!-- m -->

		<!-- Position and yaw waypoint accuracies -->
		<param name="acc_pos" type="double" value="0.1" />
		<param name="acc_yaw" type="double" value="0.1" />

		<!-- Spar parameters -->
		<param name="action_topic" type="string" value="spar/flight" />

		<!-- This should fix it, Just uncomment the below and comment the above - From Taj-->
		<!--remap from="~pose" to="/mavros/local_position/pose" /-->
		<!--remap from="~/roi" to="target_detection/roi" /-->
	</node>


	<arg name="uav_name" default="eldrone" /> <!--DOUBLE CHECK-->
	<!-- MAVROS Parameters -->
	<arg name="fcu_url" default="/dev/ttyUSB0:921600" />
	<arg name="gcs_url" default="" />
	<arg name="tgt_system" default="8" />
	<arg name="tgt_component" default="1" />
	<arg name="log_output" default="screen" />
	<arg name="fcu_protocol" default="v2.0" />
	<arg name="respawn_mavros" default="false" />

	<!-- Spar Node -->
	<remap from="spar/mav_state" to="mavros/state"/>
	<remap from="spar/pose" to="mavros/local_position/pose"/>
	<!-- Taj Addition for DEMO fix, this should remap the pose topic -->
	<!-- <remap from="~/pose" to="mavros/local_position/pose" /> -->
	<remap from="spar/setpoint" to="mavros/setpoint_raw/local"/>
	<include file="$(find spar_node)/launch/spar.launch"/>

	<!-- MAVROS Node -->
	<include file="$(find mavros)/launch/node.launch">
		<arg name="pluginlists_yaml" value="/home/uavteam6/EGB349_Project_eldrone/catkin_ws_G6/launch/px4_pluginlists.yaml" />	<!--DOUBLE CHECK-->
		<arg name="config_yaml" value="/home/uavteam6/EGB349_Project_eldrone/catkin_ws_G6/launch/px4_config.yaml" />	<!--DOUBLE CHECK-->

		<arg name="fcu_url" value="$(arg fcu_url)" />
		<arg name="gcs_url" value="$(arg gcs_url)" />
		<arg name="tgt_system" value="$(arg tgt_system)" />
		<arg name="tgt_component" value="$(arg tgt_component)" />
		<arg name="log_output" value="$(arg log_output)" />
		<arg name="fcu_protocol" value="$(arg fcu_protocol)" />
		<arg name="respawn_mavros" default="$(arg respawn_mavros)" />
	</include>

	<!-- Pose Reference -->
	<node pkg="topic_tools" type="relay" name="mocap_relay" clear_params="true" output="screen"
	args="/vicon/$(arg uav_name)/pose /mavros/vision_pose/pose"/>
	<!-- Payload Deployment subsystem: brings up motor_controller and payload_driver.
	     manual override disabled for autonomous flight. -->
	<include file="$(find egh450_payload_deploy)/launch/pdd_launch.launch"> </include>	
</launch>
